# Local dev default: a SQLite file, zero setup required.
# In production (Render), set this to your Neon connection string, e.g.:
# postgresql+psycopg2://user:password@ep-xxxx-pooler.region.aws.neon.tech/documind?sslmode=require
DATABASE_URL=sqlite:///./documind.db

# Generate a real secret for production, e.g.: openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Used by the extraction endpoint (next phase)
GROQ_API_KEY=

UPLOAD_DIR=./uploads
